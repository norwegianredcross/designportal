{
  "name": "designsystem-docs-xp",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@changesets/cli": "^2.31.0",
    "@enonic-types/core": "^7.16.4",
    "@enonic-types/global": "^7.16.4",
    "@enonic-types/guillotine": "^7.3.4",
    "@enonic-types/lib-admin": "^7.16.4",
    "@enonic-types/lib-auth": "^7.16.4",
    "@enonic-types/lib-cluster": "^7.16.4",
    "@enonic-types/lib-common": "^7.16.4",
    "@enonic-types/lib-content": "^7.16.4",
    "@enonic-types/lib-context": "^7.16.4",
    "@enonic-types/lib-event": "^7.16.4",
    "@enonic-types/lib-export": "^7.16.4",
    "@enonic-types/lib-i18n": "^7.16.4",
    "@enonic-types/lib-io": "^7.16.4",
    "@enonic-types/lib-mail": "^7.16.4",
    "@enonic-types/lib-node": "^7.16.4",
    "@enonic-types/lib-portal": "^7.16.4",
    "@enonic-types/lib-project": "^7.16.4",
    "@enonic-types/lib-repo": "^7.16.4",
    "@enonic-types/lib-scheduler": "^7.16.4",
    "@enonic-types/lib-task": "^7.16.4",
    "@enonic-types/lib-value": "^7.16.4",
    "@enonic-types/lib-websocket": "^7.16.4",
    "@item-enonic-types/lib-time": "^1.6.1",
    "@swc/core": "^1.15.40",
    "@types/node": "^22",
    "concurrently": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:assets": "node tsup/build.js src/main/resources/assets build/resources/main/assets",
    "build:server": "node tsup/build.js src/main/resources build/resources/main",
    "changeset": "changeset",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:assets": "node tsup/check.js src/main/resources/assets",
    "check:types:server": "node tsup/check.js src/main/resources src/main/resources/assets",
    "cov": "jest --no-cache --coverage",
    "format": "biome check --write",
    "lint": "biome check --error-on-warnings",
    "test": "jest --no-cache",
    "version": "changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties"
  }
}
