<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<page xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="page.default.displayName">Default</display-name>
  <description i18n="page.default.description">Default page view adding headers with menus and footer</description>

  <form>
    <input name="variant" type="RadioButton">
      <label i18n="page.default.variant">Variant</label>
      <occurrences minimum="1" maximum="1"/>
      <config>
        <option value="narrow" i18n="page.default.variant.narrow">Narrow</option>
        <option value="wide" i18n="page.default.variant.wide">Wide</option>
      </config>
      <default>narrow</default>
    </input>
  </form>

  <regions>
    <region name="header"/>
    <region name="main"/>
  </regions>
</page>
