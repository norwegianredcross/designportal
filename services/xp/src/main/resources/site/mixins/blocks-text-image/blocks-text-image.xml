<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- LOCAL block (not from lib-xp-item-blocks): the hero/split composition
     from the Design retning Figma - a text column (stikktittel, tittel,
     tekst, valgfri CTA-knapp) beside an image that can carry the notched
     silhouette. The CTA target reuses the lib's blocks-link mixin so the
     editor experience matches the cards' link picker, and the notch
     geometry is corner-based (the editor picks a corner; the frontend maps
     it onto the mask generator's edge+offset model). -->
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.blocks-text-image.displayName">Text and image</display-name>
  <description i18n="mixin.blocks-text-image.description">A text column beside an image</description>

  <form>
    <input name="kicker" type="TextLine">
      <label i18n="mixin.blocks-text-image.kicker">Kicker</label>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <input name="title" type="TextLine">
      <label i18n="mixin.blocks-text-image.title">Title</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="text" type="HtmlArea">
      <label i18n="mixin.blocks-text-image.text">Text</label>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <exclude>*</exclude>
        <include>Bold Italic Strike | RemoveFormat | SpecialChar | Link Unlink | BulletedList NumberedList</include>
      </config>
    </input>

    <input name="buttonText" type="TextLine">
      <label i18n="mixin.blocks-text-image.buttonText">Button text</label>
      <help-text i18n="mixin.blocks-text-image.buttonText.helpText">The button only shows when both text and link are set</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <mixin name="blocks-link"/>

    <input name="imageId" type="ImageSelector">
      <label i18n="mixin.blocks-text-image.image">Image</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="altText" type="TextLine">
      <label i18n="mixin.blocks-text-image.altText">Alternative text for the image</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="imagePlacement" type="ComboBox">
      <label i18n="mixin.blocks-text-image.imagePlacement">Image placement</label>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <option value="right" i18n="mixin.blocks-text-image.imagePlacement.right">Right</option>
        <option value="left" i18n="mixin.blocks-text-image.imagePlacement.left">Left</option>
      </config>
      <default>right</default>
    </input>

    <!-- Silhouette as an option-set: the notch geometry only appears when
         the editor actually chooses the notched form - fields that always
         show but only sometimes apply invite mistakes. -->
    <option-set name="form">
      <label i18n="mixin.blocks-text-image.form">Shape</label>
      <occurrences minimum="0" maximum="1"/>
      <options minimum="1" maximum="1">
        <option name="rounded">
          <label i18n="mixin.blocks-text-image.form.rounded">Rounded</label>
          <default>true</default>
        </option>
        <option name="notch">
          <label i18n="mixin.blocks-text-image.form.notch">Notch (cutout)</label>
          <items>
            <input name="corner" type="ComboBox">
              <label i18n="mixin.blocks-text-image.form.notch.corner">Corner</label>
              <occurrences minimum="0" maximum="1"/>
              <config>
                <option value="bottom-right" i18n="mixin.blocks-text-image.form.notch.corner.bottomRight">Bottom right</option>
                <option value="bottom-left" i18n="mixin.blocks-text-image.form.notch.corner.bottomLeft">Bottom left</option>
                <option value="top-right" i18n="mixin.blocks-text-image.form.notch.corner.topRight">Top right</option>
                <option value="top-left" i18n="mixin.blocks-text-image.form.notch.corner.topLeft">Top left</option>
              </config>
              <default>bottom-right</default>
            </input>
            <input name="width" type="Long">
              <label i18n="mixin.blocks-text-image.form.notch.width">Cutout width in percent</label>
              <occurrences minimum="0" maximum="1"/>
              <default>35</default>
            </input>
            <input name="depth" type="Long">
              <label i18n="mixin.blocks-text-image.form.notch.depth">Cutout depth in percent</label>
              <occurrences minimum="0" maximum="1"/>
              <default>28</default>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <mixin name="blocks-theme"/>
  </form>
</mixin>
