<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.blocks.displayName">Blocks</display-name>

  <form>
    <option-set name="blocks">
      <label i18n="mixin.blocks.blocks">Content blocks</label>
      <help-text i18n="mixin.blocks.blocks.helpText">Your page content is build by a sequence of blocks.</help-text>
      <occurrences minimum="0" maximum="0"/>

      <options minimum="1" maximum="1">
        <option name="blocks-text">
          <label i18n="mixin.blocks-text.displayName">Text</label>
          <help-text i18n="mixin.blocks-text.description">Rich text field that can contain lists and tables</help-text>
          <items>
            <mixin name="blocks-text"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-hero): the landing panel with the
             notched corner. First in the list because it is the block a
             landing page starts with. -->
        <option name="blocks-hero">
          <label i18n="mixin.blocks-hero.displayName">Hero</label>
          <help-text i18n="mixin.blocks-hero.description">Landing panel with a notched corner, title and calls to action</help-text>
          <items>
            <mixin name="blocks-hero"/>
          </items>
        </option>

        <option name="blocks-accordion">
          <label i18n="mixin.blocks-accordion.displayName">Accordion</label>
          <help-text i18n="mixin.blocks-accordion.description">A list of expandable sections</help-text>
          <items>
            <mixin name="blocks-accordion"/>
            <mixin name="blocks-theme"/>
          </items>
        </option>

        <!-- The form fields come from the blocks-quote mixin inside
             no.item:lib-xp-item-blocks - identical to the editor form on
             rodekors.no. This file only decides WHICH lib blocks are enabled
             for this app (app resources shadow the lib's own blocks.xml). -->
        <option name="blocks-quote">
          <label i18n="mixin.blocks-quote.displayName">Quote</label>
          <help-text i18n="mixin.blocks-quote.description">A stylized quote with the image of the author</help-text>
          <items>
            <mixin name="blocks-quote"/>
          </items>
        </option>

        <option name="blocks-factbox">
          <label i18n="mixin.blocks-factbox.displayName">Factbox</label>
          <help-text i18n="mixin.blocks-factbox.description">A box containing text that can have different background colors</help-text>
          <items>
            <mixin name="blocks-factbox"/>
            <!-- blocks-theme adds the color dropdown; the choices come from
                 the XP app config (no.rodekors.docs.cfg: themes=...), so the
                 same block offers RK brand scopes here and rk.no's palette
                 there without any code difference. -->
            <mixin name="blocks-theme"/>
          </items>
        </option>

        <!-- Repeatable image gallery from the lib: each entry is an
             ImageSelector plus REQUIRED alt text (enforced in the form, so
             editors cannot publish inaccessible images) and an optional
             caption. -->
        <option name="blocks-images">
          <label i18n="mixin.blocks-images.displayName">Images</label>
          <help-text i18n="mixin.blocks-images.description">An image gallery or an image that can be expanded</help-text>
          <items>
            <mixin name="blocks-images"/>
            <mixin name="blocks-width"/>
          </items>
        </option>

        <!-- Card grid from the lib. The cards form composes three lib
             mixins per card (blocks-card fields + blocks-theme color +
             blocks-link's internal/external/none choice) and adds grid
             options (column count, image placement) on the block itself. -->
        <option name="blocks-cards">
          <label i18n="mixin.blocks-cards.displayName">Cards</label>
          <help-text i18n="mixin.blocks-cards.description">Cards can have a title, text, image and can link to content</help-text>
          <items>
            <mixin name="blocks-cards"/>
            <!-- blocks-width lets this one section run wider than the content
                 column, the way the block template's closing list does. -->
            <mixin name="blocks-width"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-code) — the only option so far
             whose form does NOT come from lib-xp-item-blocks. Docs-specific:
             copyable code snippets for the developer documentation. -->
        <option name="blocks-code">
          <label i18n="mixin.blocks-code.displayName">Code</label>
          <help-text i18n="mixin.blocks-code.description">A copyable block of code with a language label</help-text>
          <items>
            <mixin name="blocks-code"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-demo): live design system
             examples, picked from a curated registry — see the mixin file
             for why editors never write component code themselves. -->
        <option name="blocks-demo">
          <label i18n="mixin.blocks-demo.displayName">Component demo</label>
          <help-text i18n="mixin.blocks-demo.description">A live example of a design system component</help-text>
          <items>
            <mixin name="blocks-demo"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-summary): key figures with an
             optional link, per the BLOKK_OPPSUMMERING wireframe. -->
        <option name="blocks-summary">
          <label i18n="mixin.blocks-summary.displayName">Summary</label>
          <help-text i18n="mixin.blocks-summary.description">Key figures with an optional link</help-text>
          <items>
            <mixin name="blocks-summary"/>
            <mixin name="blocks-width"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-table): a styled table edited
             with Content Studio's rich-text table tooling. -->
        <option name="blocks-table">
          <label i18n="mixin.blocks-table.displayName">Table</label>
          <help-text i18n="mixin.blocks-table.description">A table with an optional title</help-text>
          <items>
            <mixin name="blocks-table"/>
          </items>
        </option>

        <!-- LOCAL block (site/mixins/blocks-components): the component
             catalogue, generated from the library's published manifest.
             See the mixin file for why editors never type the list. -->
        <option name="blocks-components">
          <label i18n="mixin.blocks-components.displayName">Component catalogue</label>
          <help-text i18n="mixin.blocks-components.description">Every component in the library, linked to its Storybook documentation</help-text>
          <items>
            <mixin name="blocks-components"/>
          </items>
        </option>
      </options>
    </option-set>
  </form>
</mixin>
