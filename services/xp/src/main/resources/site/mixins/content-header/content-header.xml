<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Title + intro shown at the top of every page. The intro's toolbar is
     deliberately stripped to a minimal set (exclude * / include list below)
     - same trimmed editor experience as rodekors.no. -->
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.content-header.displayName">Content header</display-name>

  <form>
    <field-set>
      <label i18n="mixin.content-header.displayName">Content header</label>
      <items>
        <!-- The article kicker ("stikktittel"/category line) above the
             title, per the docs SPA's article shell. -->
        <input type="TextLine" name="kicker">
          <label i18n="mixin.content-header.kicker">Kicker</label>
          <occurrences minimum="0" maximum="1"/>
        </input>

        <input type="TextLine" name="title">
          <label i18n="mixin.content-header.title">Title</label>
          <occurrences minimum="0" maximum="1"/>
        </input>

        <!-- Header navigation is curated: editors tick this on the few
             pages that belong in the main menu (the common query collects
             them on every render). -->
        <input name="showInMenu" type="CheckBox">
          <label i18n="mixin.content-header.showInMenu">Show in main menu</label>
          <default>unchecked</default>
        </input>

        <input name="intro" type="HtmlArea">
          <label i18n="mixin.content-header.intro">Intro</label>
          <occurrences minimum="0" maximum="1"/>
          <config>
            <exclude>*</exclude>
            <include>Bold Italic Strike | RemoveFormat | SpecialChar Macro | Link Unlink</include>
          </config>
        </input>
      </items>
    </field-set>
  </form>
</mixin>
