<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- LOCAL block (not from lib-xp-item-blocks): the landing hero, after the
     Designretning board's own hero (Figma Design-retning 2436:44864): a
     cream panel whose bottom-right corner is stepped away with the cross
     mark sitting in the gap, kicker, display title, lead and calls to
     action on the left, and optionally a photograph on the right.
     The badge is a small stamp above the kicker (the release tag on the
     front page) plus a quiet meta word; both are editorial rather than
     derived, because the CMS has no view of package.json.
     Actions are an item-set rather than two fixed link fields so the block
     composes blocks-link once per action, the same internal/external
     choice the cards use. -->
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.blocks-hero.displayName">Hero</display-name>
  <description i18n="mixin.blocks-hero.description">Landing panel with a stepped corner, title, calls to action and an optional photo</description>

  <form>
    <input name="badge" type="TextLine">
      <label i18n="mixin.blocks-hero.badge">Badge</label>
      <help-text i18n="mixin.blocks-hero.badge.helpText">The stamp in the notched corner, e.g. a version number</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <input name="badgeMeta" type="TextLine">
      <label i18n="mixin.blocks-hero.badgeMeta">Badge meta</label>
      <help-text i18n="mixin.blocks-hero.badgeMeta.helpText">Quiet text beside the stamp, e.g. "Open Source"</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <input name="kicker" type="TextLine">
      <label i18n="mixin.blocks-hero.kicker">Kicker</label>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <input name="title" type="TextLine">
      <label i18n="mixin.blocks-hero.title">Title</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="lead" type="TextArea">
      <label i18n="mixin.blocks-hero.lead">Lead</label>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <!-- Optional: with a photo the panel splits into text and picture, the
         picture running to the panel's right edge the way the board's front
         page bleeds its hero photo. Alt text comes from the media item. -->
    <input name="image" type="ImageSelector">
      <label i18n="mixin.blocks-hero.image">Photo</label>
      <help-text i18n="mixin.blocks-hero.image.helpText">Shown to the right of the text; leave empty for a text-only panel</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <item-set name="actions">
      <label i18n="mixin.blocks-hero.action">Call to action</label>
      <help-text i18n="mixin.blocks-hero.action.helpText">The first is rendered as the primary button, the second as secondary</help-text>
      <occurrences minimum="0" maximum="2"/>
      <items>
        <input name="linkText" type="TextLine">
          <label i18n="mixin.blocks-hero.action.linkText">Button text</label>
          <occurrences minimum="1" maximum="1"/>
        </input>
        <mixin name="blocks-link"/>
      </items>
    </item-set>
  </form>
</mixin>
