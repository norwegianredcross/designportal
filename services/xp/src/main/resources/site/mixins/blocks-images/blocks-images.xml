<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SHADOWS the same-named mixin in lib-xp-item-blocks (app resources win
     over included libs' resources, the same mechanism as blocks/blocks.xml):
     the lib's item-set is kept verbatim so the editorial experience matches
     rodekors.no, with app additions for single images: size, alignment and
     the Design retning silhouette (rounded, or a notch cut into a chosen
     corner). The frontend renders the notch via a generated SVG mask
     (services/next .../notchMask.ts). -->
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.blocks-images.displayName">Images</display-name>
  <description i18n="mixin.blocks-images.description">An image gallery or an image that can be expanded</description>

  <form>
    <item-set name="items">
      <label i18n="mixin.blocks-images.image">Image</label>
      <occurrences minimum="1" maximum="0"/>

      <items>
        <input name="imageId" type="ImageSelector">
          <label i18n="mixin.blocks-images.image.image">Image</label>
          <occurrences minimum="1" maximum="1"/>
        </input>

        <input name="altText" type="TextLine">
          <label i18n="mixin.blocks-images.image.altText">Description of the image for visually impaired users (alt text)</label>
          <help-text i18n="mixin.blocks-images.altTextHelpText">Describe the image in context of the article</help-text>
          <occurrences minimum="1" maximum="1"/>
        </input>

        <input name="caption" type="TextLine">
          <label i18n="mixin.blocks-images.image.caption">Caption</label>
          <occurrences minimum="0" maximum="1"/>
        </input>
      </items>
    </item-set>

    <!-- Everything below is the app's addition; only applied when the block
         holds a single image (galleries keep uniform rounded tiles). -->
    <input name="size" type="ComboBox">
      <label i18n="mixin.blocks-images.size">Size</label>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <option value="full" i18n="mixin.blocks-images.size.full">Full width</option>
        <option value="medium" i18n="mixin.blocks-images.size.medium">Medium</option>
        <option value="small" i18n="mixin.blocks-images.size.small">Small</option>
      </config>
      <default>medium</default>
    </input>

    <input name="alignment" type="ComboBox">
      <label i18n="mixin.blocks-images.alignment">Alignment</label>
      <help-text i18n="mixin.blocks-images.alignment.helpText">Only applies below full width</help-text>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <option value="left" i18n="mixin.blocks-images.alignment.left">Left</option>
        <option value="right" i18n="mixin.blocks-images.alignment.right">Right</option>
      </config>
      <default>left</default>
    </input>

    <!-- Silhouette as an option-set, the same editor model as the
         tekst-og-bilde block: the notch geometry only appears when the
         editor actually chooses the notched form — fields that always show
         but only sometimes apply invite mistakes (they did). The corner
         dropdown replaces the earlier edge+offset numbers; the frontend
         maps a corner onto the mask generator's more general model. -->
    <option-set name="form">
      <label i18n="mixin.blocks-images.form">Shape</label>
      <occurrences minimum="0" maximum="1"/>
      <options minimum="1" maximum="1">
        <option name="rounded">
          <label i18n="mixin.blocks-images.form.rounded">Rounded</label>
          <default>true</default>
        </option>
        <option name="notch">
          <label i18n="mixin.blocks-images.form.notch">Notch (cutout)</label>
          <items>
            <input name="corner" type="ComboBox">
              <label i18n="mixin.blocks-images.form.notch.corner">Corner</label>
              <occurrences minimum="0" maximum="1"/>
              <config>
                <option value="bottom-right" i18n="mixin.blocks-images.form.notch.corner.bottomRight">Bottom right</option>
                <option value="bottom-left" i18n="mixin.blocks-images.form.notch.corner.bottomLeft">Bottom left</option>
                <option value="top-right" i18n="mixin.blocks-images.form.notch.corner.topRight">Top right</option>
                <option value="top-left" i18n="mixin.blocks-images.form.notch.corner.topLeft">Top left</option>
              </config>
              <default>bottom-right</default>
            </input>
            <input name="width" type="Long">
              <label i18n="mixin.blocks-images.form.notch.width">Cutout width in percent</label>
              <occurrences minimum="0" maximum="1"/>
              <default>35</default>
            </input>
            <input name="depth" type="Long">
              <label i18n="mixin.blocks-images.form.notch.depth">Cutout depth in percent</label>
              <occurrences minimum="0" maximum="1"/>
              <default>28</default>
            </input>
          </items>
        </option>
      </options>
    </option-set>

  </form>
</mixin>
